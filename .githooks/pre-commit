#!/usr/bin/env python3
"""在提交前拒绝私有文件，并扫描暂存区中的密钥。"""
import pathlib
import re
import shutil
import subprocess
import sys

paths = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"]
).decode().split("\0")
blocked = []
root = pathlib.Path(subprocess.check_output(
    ["git", "rev-parse", "--show-toplevel"]
).decode().strip())
local_secrets = []
for env_file in root.glob(".env*"):
    if not env_file.is_file() or env_file.name == ".env.example":
        continue
    for line in env_file.read_text().splitlines():
        name, separator, value = line.strip().removeprefix("export ").partition("=")
        value = value.strip().strip("\"'")
        if (
            separator and not name.startswith("#")
            and re.search(r"(key|secret|password|token|(?:^|_)(?:ak|sk)$)", name, re.I)
            and not name.endswith("MAX_TOKENS") and len(value) >= 8
        ):
            local_secrets.append(value.encode())
for name in filter(None, paths):
    path = pathlib.PurePosixPath(name)
    parts = set(path.parts)
    if (
        (path.name.startswith(".env") and path.name != ".env.example")
        or path.name in {".envrc", ".netrc", "id_rsa", "id_ed25519", "id_ecdsa"}
        or path.suffix.lower() in {".pem", ".key", ".p12", ".pfx", ".log", ".pid", ".sqlite", ".sqlite3", ".db", ".tmp", ".bak"}
        or parts & {"data", "node_modules", "__pycache__", ".trae", ".vscode", ".secrets"}
        or re.match(r"(credentials|service-account).*\.json$", path.name)
    ):
        blocked.append(name)
    staged = subprocess.check_output(["git", "show", ":" + name])
    if any(secret in staged for secret in local_secrets):
        blocked.append(name)
if blocked:
    print("提交已阻止：暂存区包含私有配置、密钥或运行文件。", file=sys.stderr)
    print("\n".join(blocked), file=sys.stderr)
    sys.exit(1)
if not shutil.which("gitleaks"):
    print("提交已阻止：请安装 Gitleaks（macOS: brew install gitleaks）。", file=sys.stderr)
    sys.exit(1)
sys.exit(subprocess.call(["gitleaks", "git", "--pre-commit", "--staged", "--redact", "."]))
