# Movie Agent：复制到 .env，填写密钥及自己账户可用的模型端点。
# Copy to .env and use your own API key and available model endpoints.
ARK_API_KEY=
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
LLM_MODEL_IMAGE=
IMAGE_SIZE=2048x1536
MAIN_AGENT_MODEL=
MAIN_AGENT_MAX_TOKENS=65536
VISION_REVIEW_MODEL=
VIDEO_MODEL=
SCRIPT_LLM_TEMPERATURE=0.9

# Seed-Speech uses its own server-side API key and domain.
SPEECH_APPID=
SPEECH_API_KEY=
SPEECH_ASR_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3/auc/bigmodel/recognize/flash
SPEECH_RESOURCE_ID=volc.seedasr.auc_turbo
# Server-side credentials for private TOS storage; never expose to browsers.
BYTEPLUS_AK=
BYTEPLUS_SK=
STORAGE_BACKEND=tos
TOS_REGION=ap-southeast-1
TOS_BUCKET=movie-novel
TOS_ENDPOINT=https://tos-ap-southeast-1.bytepluses.com
# Cloud access only; keep false for local development.
WEBUI_CLOUD_MODE=false
WEBUI_ACCESS_PASSWORD=
WEBUI_SESSION_SECRET=
