# Copy this file to `.env` and fill in your Volcengine AK/SK.
# VeADK loads `.env` from the current working directory. This file is for
# running the agent locally — it is NOT uploaded to the runtime on
# `agentkit deploy`.

# --- Volcengine credentials ---
# Set your AK/SK to run the agent locally — the model credential is derived from
# them automatically. On the AgentKit cloud runtime this is provided for you, so
# there is nothing else to configure.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# VOLCENGINE_REGION=cn-beijing

# --- Agent reasoning model (optional) ---
# You normally do NOT set these — the model credential comes from AK/SK above.
# Uncomment to pin a specific model/provider locally. Do NOT leave a placeholder
# value: a non-empty MODEL_AGENT_API_KEY overrides the automatic credential and
# will fail auth.
# MODEL_AGENT_PROVIDER=openai
# MODEL_AGENT_NAME=doubao-seed-1-6-250615
# MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
# MODEL_AGENT_API_KEY=

# --- Required by this template (referenced in .agentkit/agentkit.yaml) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- Agent 推理模型（本 demo 固定使用指定的方舟推理接入点）---
MODEL_AGENT_API_KEY=
MODEL_AGENT_NAME=ep-20260804114747-mc7ct
MODEL_AGENT_PROVIDER=openai
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/

# --- 图片/视频生成模型（主模型；代码会在“模型相关错误”时自动降级重试）---
# image 主模型；降级链：seedream-5-0-260128 / 4-5-251128 / 4-0-250828
MODEL_IMAGE_NAME=doubao-seedream-5-0-pro-260628
# video 主模型；降级链：seedance-1-5-pro-251215 / 1-0-pro-250528
MODEL_VIDEO_NAME=doubao-seedance-2-0-260128

# --- AgentKit Sandbox tool_id（run_code / coding / execute_skills）---
AGENTKIT_TOOL_ID=t-yes2y0gzk0gumvo43ppk
AGENTKIT_TOOL_ID_SCRIPT=t-yes2y0gzk0gumvo43ppk
AGENTKIT_TOOL_ID_OPENCODE=t-yes2y0gzk0gumvo43ppk
AGENTKIT_TOOL_ID_SKILLS=t-yes2y0gzk0gumvo43ppk

# --- 本地知识沉淀（sqlite）---
VEADK_LOCAL_KB_DB_PATH=/tmp/movie_script_local_knowledge.db

# --- Web UI（BFF）：调用云端 Agent 的域名与 apikey（仅服务端保管，不下发前端）---
# CLOUD_AGENT_API_KEY 是 AgentKit API 网关的「消费者 apikey」，与方舟模型 key 不同。
CLOUD_AGENT_BASE_URL=https://your-runtime.apigateway-cn-beijing.volceapi.com
CLOUD_AGENT_API_KEY=
CLOUD_AGENT_APP_NAME=movie_script_agent
# 部署到 VeFaaS 时置为 false（云端没有本地 :8000），本地调试用 run_local.sh 会强制 true。
WEBUI_ENABLE_LOCAL=false

# --- 上下文自动压缩 / 本地会话存储（可选覆盖，均有默认值）---
# VEADK_STM_DB_PATH=/tmp/movie_script_sessions.db
# VEADK_COMPACTION_INTERVAL=6
# VEADK_COMPACTION_OVERLAP=1
# VEADK_COMPACTION_TOKEN_THRESHOLD=24000
# VEADK_COMPACTION_RETENTION=30
# VEADK_MAX_OUTPUT_TOKENS=3000
# VEADK_CONTINUATION_MAX_OUTPUT_TOKENS=2200
# VEADK_OUTPUT_MEMORY_DB_PATH=/tmp/movie_script_output_memory.db
# VEADK_AUTO_CONTINUE_MAX_STEPS=4
# VEADK_AUTO_CONTINUE_TAIL_CHARS=3000
